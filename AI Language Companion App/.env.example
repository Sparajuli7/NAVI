# ──────────────────────────────────────────────────────
# NAVI Environment Variables
# ──────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase — get these from your Supabase project dashboard:
# https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenRouter API key — required for production inference
# Set this in Vercel project environment variables (server-side only — never prefix with VITE_)
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=
