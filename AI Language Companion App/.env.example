# ──────────────────────────────────────────────────────
# NAVI Environment Variables
# ──────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase — get these from your Supabase project dashboard:
# https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenRouter — BYOK path (optional).
# If set, the client can use OpenRouter directly with THIS key (embedded in the
# browser bundle — only use a key you're OK exposing, or leave unset for true BYOK).
# VITE_OPENROUTER_API_KEY=sk-or-...

# ──────────────────────────────────────────────────────
# NAVI Cloud — managed free-credits model (server-side only)
# ──────────────────────────────────────────────────────
# These power api/chat.ts + api/usage.ts. Set them in Vercel project settings
# (Production + Preview). They are NOT VITE_-prefixed, so they never reach the
# browser. See MONETIZATION.md for the full setup + tuning guide.

# The OpenRouter key that funds the shared credit pool (server-held, never exposed):
# OPENROUTER_API_KEY=sk-or-...

# Supabase server credentials (URL/anon fall back to the VITE_ vars above if unset):
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # Settings → API → service_role (KEEP SECRET)
